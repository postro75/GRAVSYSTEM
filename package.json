{
  "name": "gravsystem",
  "version": "1.0.0",
  "private": true,
  "description": "AI DAW in the browser — text-to-DAW generation, browser editing, and multi-DAW export.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspace=apps/web && npm run build --workspace=apps/api",
    "lint": "npm run lint --workspace=apps/web",
    "type-check": "npm run type-check --workspace=apps/web",
    "test": "npm run test --workspace=apps/web",
    "test:api": "npm run test --workspace=apps/api",
    "ci": "npm run lint && npm run type-check && npm run test"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "smplr": "^1.0.0"
  }
}
